# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Tên LLM chung cho mọi luồng; khởi động lại backend sau khi đổi.
# think, temperature, num_predict... vẫn đặt riêng trong từng hàm/file.
LLM_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=180

# Retrieval
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# Nếu đã có model local, bỏ comment và trỏ đến thư mục snapshot/model:
# EMBEDDING_MODEL_PATH=C:/path/to/bge-m3
CHAT_GLOBAL_TOP_K=6
MAX_CONTEXT_CHARS=12000
QUYCHE_VECTOR_TOP_K=6
THONG_BAO_TOP_K_PER_LABEL=3
